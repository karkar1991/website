# Copy this file to .env and change every value. Never commit .env.

# ---- Database ----
POSTGRES_USER=member_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=member_admin

# ---- API ----
# generate with:  openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_USERNAME=admin
# first login password for the 'admin' account (set once on first start)
ADMIN_PASSWORD=change_this_admin_password
# Day boundaries for filters & daily reports (Asia/Yangon or Asia/Bangkok)
APP_TIMEZONE=Asia/Yangon
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Lock an admin account after this many wrong passwords, for LOCK_MINUTES
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Name shown in the authenticator app for 2FA
TOTP_ISSUER="Member Admin"

# ---- Telegram alerts for new deposits / withdrawals (optional) ----
# Create a bot with @BotFather, add it to your finance group, put the group id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Backups (scripts/backup.sh) ----
BACKUP_DIR=./backups
KEEP_DAYS=14

# ---- Web ----
WEB_PORT=8080

# ---- Traefik (only for docker-compose.traefik.yml) ----
DOMAIN=admin.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
